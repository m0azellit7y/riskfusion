# Copy to .env and adjust. Never commit a real .env.
RISKFUSION_DATABASE_URL=postgresql+psycopg://riskfusion:riskfusion@localhost:5432/riskfusion
# Used only by the test suite (a separate, disposable database).
RISKFUSION_TEST_DATABASE_URL=postgresql+psycopg://riskfusion:riskfusion@localhost:5432/riskfusion_test
# Local object storage root for recordings (S3-compatible backend can be swapped in later).
RISKFUSION_STORAGE_ROOT=./storage
RISKFUSION_DATA_ROOT=./data
# Upload limits
RISKFUSION_MAX_UPLOAD_MB=1024
# Comma-separated origins allowed to call the API from a browser.
RISKFUSION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Current consent form version shown to participants.
RISKFUSION_CONSENT_VERSION=consent-v1.0
# Postgres credentials used by docker-compose
POSTGRES_USER=riskfusion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=riskfusion
