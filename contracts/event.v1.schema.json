                  "occluded",
                  "device_unavailable",
                  "connection_lost",
                  "detector_error",
                  "permission_denied",
                  "not_observable"
                ]
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ATTENTION_UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "attention"
          },
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "no_frames",
                  "low_light",
                  "occluded",
                  "device_unavailable",
                  "connection_lost",
                  "detector_error",
                  "permission_denied",
                  "not_observable"
                ]
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ENVIRONMENT_UNKNOWN"
          }
