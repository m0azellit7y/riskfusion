                "type": "boolean"
              }
            },
            "required": [
              "active"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "PASTE"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "screen"
          },
          "payload": {
            "type": "object",
            "properties": {
              "length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "length"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "MONITOR_COUNT"
          }
        }
      },
      "then": {
        "properties": {
