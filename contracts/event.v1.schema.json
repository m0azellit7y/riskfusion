          },
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "no_frames",
                  "low_light",
                  "occluded",
                  "device_unavailable",
                  "connection_lost",
                  "detector_error",
                  "permission_denied",
                  "not_observable"
                ]
              }
