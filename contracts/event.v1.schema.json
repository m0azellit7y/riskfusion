          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "behavioral"
          },
          "payload": {
            "type": "object",
            "properties": {
              "keystrokes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "window_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              }
            },
            "required": [
              "keystrokes",
              "window_s"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "PRESENCE_UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "presence"
          },
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "no_frames",
                  "low_light",
                  "occluded",
                  "device_unavailable",
                  "connection_lost",
                  "detector_error",
                  "permission_denied",
                  "not_observable"
                ]
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "IDENTITY_UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
