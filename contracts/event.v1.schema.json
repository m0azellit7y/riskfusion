{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riskfusion.local/contracts/event.v1.schema.json",
  "title": "event.v1",
  "type": "object",
  "required": [
    "schema",
    "session_id",
    "ts_ms",
    "channel",
    "detector",
    "detector_version",
    "event_type",
    "payload",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "event.v1"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-]{3,64}$"
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0
    },
    "channel": {
      "enum": [
        "presence",
        "identity",
        "liveness",
        "attention",
        "environment",
        "pose",
        "audio_voice",
        "audio_event",
        "screen",
        "device",
        "behavioral"
      ]
    },
    "detector": {
      "type": "string",
      "minLength": 1
    },
    "detector_version": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "FACE_OBSERVATION",
        "IDENTITY_CHECK",
        "LIVENESS_CHECK",
        "HEAD_GAZE",
        "PERSON_COUNT",
        "OBJECT_DETECTED",
        "BODY_POSE",
        "VOICE_ACTIVITY",
        "AUDIO_EVENT",
        "TAB_VISIBILITY",
        "FULLSCREEN_CHANGE",
        "PASTE",
        "MONITOR_COUNT",
        "INPUT_ACTIVITY",
        "PRESENCE_UNKNOWN",
        "IDENTITY_UNKNOWN",
        "LIVENESS_UNKNOWN",
        "ATTENTION_UNKNOWN",
        "ENVIRONMENT_UNKNOWN",
        "POSE_UNKNOWN",
        "AUDIO_VOICE_UNKNOWN",
        "AUDIO_EVENT_UNKNOWN",
        "SCREEN_UNKNOWN",
        "DEVICE_UNKNOWN",
        "BEHAVIORAL_UNKNOWN"
      ]
    },
    "payload": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "quality": {
      "type": "object",
      "properties": {
        "frame_blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "frame_luma": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "usable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "FACE_OBSERVATION"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "presence"
          },
          "payload": {
            "type": "object",
            "properties": {
              "face_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "bbox_area_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "center_offset_x": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "center_offset_y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "required": [
              "face_count",
              "bbox_area_ratio",
              "center_offset_x",
              "center_offset_y"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "IDENTITY_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "identity"
          },
          "payload": {
            "type": "object",
            "properties": {
              "cosine_sim": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "verified": {
                "type": "boolean"
              },
              "face_quality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "cosine_sim",
              "verified",
              "face_quality"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "LIVENESS_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "liveness"
          },
          "payload": {
            "type": "object",
            "properties": {
              "pad_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "pad_pass": {
                "type": "boolean"
              }
            },
            "required": [
              "pad_score",
              "pad_pass"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "HEAD_GAZE"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "attention"
          },
          "payload": {
            "type": "object",
            "properties": {
              "yaw": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "pitch": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "roll": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "gaze_on_screen_prob": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "yaw",
              "pitch",
              "roll",
              "gaze_on_screen_prob"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "PERSON_COUNT"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "environment"
          },
          "payload": {
            "type": "object",
            "properties": {
              "n_persons": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              }
            },
            "required": [
              "n_persons"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "OBJECT_DETECTED"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "environment"
          },
          "payload": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "enum": [
                  "cell_phone",
                  "book",
                  "laptop",
                  "tv",
                  "remote",
                  "person",
                  "headphones",
                  "paper"
                ]
              },
              "bbox_x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bbox_y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bbox_w": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bbox_h": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "label",
              "bbox_x",
              "bbox_y",
              "bbox_w",
              "bbox_h"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "BODY_POSE"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "pose"
          },
          "payload": {
            "type": "object",
            "properties": {
              "hands_visible_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "reach_off_frame": {
                "type": "boolean"
              },
              "torso_rotation": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "hands_visible_count",
              "reach_off_frame",
              "torso_rotation"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "VOICE_ACTIVITY"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "audio_voice"
          },
          "payload": {
            "type": "object",
            "properties": {
              "vad_active": {
                "type": "boolean"
              },
              "speaker_is_candidate": {
                "type": "boolean"
              },
              "n_speakers": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "foreign_speech": {
                "type": "boolean"
              }
            },
            "required": [
              "vad_active",
              "speaker_is_candidate",
              "n_speakers",
              "foreign_speech"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "AUDIO_EVENT"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "audio_event"
          },
          "payload": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "enum": [
                  "keyboard_burst",
                  "phone_ring",
                  "paper_rustle",
                  "door",
                  "other"
                ]
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "TAB_VISIBILITY"
          }
        }
      },
      "then": {
        "properties": {
          "channel": {
            "const": "screen"
          },
          "payload": {
            "type": "object",
